            fail2ban trust add|del --jail NAME --ip ADDR|CIDR
                                 增删可信 IP（运行态 + 校验后持久化）
            fail2ban jail enable|disable --name NAME
                                 开关某个由 Idleleo 托管的 jail
            xray install --binary PATH
                                 用本地二进制安装 Xray 并接管根目录
