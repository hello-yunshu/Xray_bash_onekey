  "edits": [
    {
      "id": "E1",
      "name": "config-edit-before-after",
      "base": "M1",
      "method": "M1 安装 -> xray share/config 取证 -> xray config edit --uuid --yes --container -> L4 + 改后取证",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--uuid",
          "99999999-8888-7777-6666-555555555555",
          "--yes",
          "--container",
          "--json"
        ]
      },
      "checks": [
        "editRcZero",
        "configChanged",
        "uuidApplied",
        "shareUriUpdated",
        "serviceActive",
        "backupExists"
      ],
      "l4": "reality",
      "notes": "Go 独有能力，bash 侧无 UUID 非交互入口；判定只看 Go 改前/改后与 L4。"
    },
    {
      "id": "E2",
      "name": "config-edit-restart-rollback",
      "base": "M1",
      "method": "注入一次性 Xray 重启失败（systemd drop-in）-> config edit --port 8443 -> 期望 rc!=0、配置 SHA 还原、服务 active、L4 仍通",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--port",
          "8443",
          "--yes",
          "--container",
          "--json"
        ]
      },
      "checks": [
        "editRcNonZero",
        "rollbackReported",
        "configRestored",
        "serviceActive"
      ],
      "l4": "reality",
      "notes": "drop-in 只在首次 ExecStartPre 失败，回滚重启可成功，用于验证真回滚而非永久坏服务。"
    },
    {
      "id": "E3",
      "name": "config-edit-target-probe-refused",
      "base": "M1",
      "method": "M1 安装 -> config edit --target 127.0.0.1:1（拒连端口）-> 期望 rc=2、配置 SHA 不变、无备份、服务 active、L4 仍通",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--target",
          "127.0.0.1:1",
          "--container",
          "--json"
        ]
      },
      "checks": [
        "probeRefused",
        "configRestored",
        "serviceActive",
        "noBackup"
      ],
      "l4": "reality",
      "notes": "回源探测失败必须阻断保存（rc=2、零落盘），不允许把断线配置写进现网。"
    },
    {
      "id": "E4",
      "name": "config-edit-target-probe-ok",
      "base": "M1",
      "method": "M1 安装 -> 驱动内起本地 TLS 回源 :8443（本地 CA 签发 local.test，CA 注入服务端与客户端容器信任库）-> config edit --target 127.0.0.1:8443 --server-names local.test -> 期望 rc=0、target 落盘、探测记录、服务 active、L4 仍通（客户端 SNI 随 serverNames 变为 local.test）",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--target",
          "127.0.0.1:8443",
          "--server-names",
          "local.test",
          "--container",
          "--json"
        ]
      },
      "checks": [
        "editRcZero",
        "configChanged",
        "targetApplied",
        "probeReported",
        "serviceActive"
      ],
      "l4": "reality",
      "notes": "探测按系统根证书校验链 + hostname（与 Reality 要求等价，不额外查 OCSP、不锁 TLS 版本）；E2E 用受信本地 CA 签发的本地 TLS listener 代替外网回源，不给生产加 --skip-probe 后门。本地 origin 必须像真实站点一样协商 ALPN（h2/http1.1），否则 Reality 会判为 invalid 并回退（已取证）。"
    },
    {
      "id": "E5",
      "name": "config-edit-tls-cert-success",
      "base": "M4",
      "method": "M4 安装（TLS/ws，Nginx 443，证书 /etc/idleleo/cert/xray.crt）-> schedule install 写入 cert-renew 目标 -> 生成同域名新自签对 -> xray config edit --cert/--cert-key -> 校验写入/reload/握手/jobs.json/备份/不重启 Xray -> 改后 L4",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--cert",
          "/etc/idleleo/cert/e5-new.crt",
          "--cert-key",
          "/etc/idleleo/cert/e5-new.key",
          "--yes",
          "--container",
          "--json"
        ]
      },
      "l4Profile": "tls",
      "l4Transport": "ws",
      "checks": [
        "editRcZero",
        "probeOk",
        "tlsVersion13",
        "wireCertMatches",
        "fragmentUpdated",
        "backupHasOldCert",
        "backupHasOldKey",
        "scheduleUpdated",
        "runtimeUnchanged",
        "xrayNotRestarted",
        "servicesActive"
      ],
      "notes": "M4 的证书/域名编辑是前端所有，runtime JSON 必须逐字节不变且 Xray 不重启；旧对被备份到 edit-<ts>/。"
    },
    {
      "id": "E6",
      "name": "config-edit-tls-rollback",
      "base": "M4",
      "method": "M4 安装 + schedule install -> (a) --domain other.test 触发写前拒写 -> (b) 合法新对 + nginx ExecReload 静默 no-op -> 探针发现证书不符 -> 全量回滚 -> 改后 L4",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--cert",
          "/etc/idleleo/cert/e6-new.crt",
          "--cert-key",
          "/etc/idleleo/cert/e6-new.key",
          "--yes",
          "--container",
          "--json"
        ]
      },
      "l4Profile": "tls",
      "l4Transport": "ws",
      "checks": [
        "guardRejected",
        "guardZeroWrites",
        "rollbackRcNonZero",
        "probeFailureRecorded",
        "configRestored",
        "nginxRestored",
        "scheduleRestored",
        "servedCertRestored",
        "backupHasOldPair",
        "servicesActive"
      ],
      "notes": "E6a 证明写前守卫零落盘；E6b 由 reload 静默未生效制造真实握手失败，证明写入后探针会触发 runtime/nginx/jobs.json 全量回滚且服务保持 active。"
    },
    {
      "id": "E7",
      "name": "config-edit-shortid-transition",
      "base": "M1",
      "method": "M1 安装 -> 旧链接先探通 -> --short-id-auto 追加 sid -> 旧/新链接都探通 -> --short-id-remove 旧 sid -> 旧链接探失败、新链接探通",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--short-id-auto",
          "--host",
          "127.0.0.1",
          "--container",
          "--json"
        ]
      },
      "checks": [
        "baselineLinkWorks",
        "appendRcZero",
        "appendKeepsOldSid",
        "newLinkUsesNewSid",
        "appendRestartedService",
        "oldLinkWorksAfterAppend",
        "newLinkWorksAfterAppend",
        "removeRcZero",
        "oldSidGone",
        "removeRestartedService",
        "oldLinkFailsAfterRemove",
        "newLinkStillWorks",
        "serviceActive"
      ],
      "l4": "reality",
      "notes": "推荐流程：追加新 id -> 客户端切换 -> 删除旧 id。追加与删除都会重启 Xray（秒级重连），但旧链接在旧 sid 仍被接受期间必须一直可用；探针用真实 xray 客户端 + 隧道内 TLS 握手 + 认证后的 HTTP 请求，避免 Reality 回退造成握手假通过。"
    },
    {
      "id": "E8",
      "name": "config-edit-privatekey-rotate-rollback",
      "base": "M1",
      "method": "M1 安装 -> 键入确认串轮换 privateKey -> 新链接探通、旧链接失效、备份含 old-share-uri.txt -> 注入冻结配置的 systemd drop-in -> 再轮换：重启成功但新凭据未生效 -> 真实握手失败 -> failurePoint=reality-handshake -> 自动回滚 -> 旧链接探通",
      "go": {
        "argv": [
          "idleleo",
          "xray",
          "config",
          "edit",
          "--rotate-reality-private-key",
          "--confirm-reality-rotation",
          "rotate-reality-key",
          "--host",
          "127.0.0.1",
          "--container",
          "--json"
        ]
      },
