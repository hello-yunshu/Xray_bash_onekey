 Clash 配置分享: 
proxies:

  - name: VLESS-2001:db8::42-ws
    type: vless
    server: '2001:db8::42'
    port: 10226
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: false
    network: ws
    ws-opts:
      path: /63ca81
      headers:
        Host: 2001:db8::42
    skip-cert-verify: false

  - name: VLESS-2001:db8::42-grpc
    type: vless
    server: '2001:db8::42'
    port: 10198
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: false
    network: grpc
    grpc-opts:
      grpc-service-name: 9bf09d
    skip-cert-verify: false

  - name: VLESS-2001:db8::42-xhttp
    type: vless
    server: '2001:db8::42'
    port: 11556
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: false
    network: xhttp
    xhttp-opts:
      path: /90db40
      mode: auto
    skip-cert-verify: false

