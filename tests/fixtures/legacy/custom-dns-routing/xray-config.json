{
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 9443,
      "listen": "0.0.0.0",
      "protocol": "VLESS",
      "tag": "VLESS-Reality-in",
      "settings": {
        "clients": [
          {
            "id": "11111111-2222-4333-8444-555555555555",
            "flow": "xtls-rprx-vision",
            "level": 0,
            "email": "fixture@example.invalid"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "security": "reality",
        "realitySettings": {
          "target": "www.example.invalid:443",
          "serverNames": [
            "www.example.invalid"
          ],
          "privateKey": "oD7nlMJVY4oXH5eom_ijOe741Y4WDjpCm6_bzYRCvmk",
          "shortIds": [
            "0123456789abcdef"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    },
    {
      "protocol": "socks",
      "tag": "custom-out",
      "settings": {
        "servers": [
          {
            "address": "198.51.100.20",
            "port": 1080
          }
        ]
      }
    }
  ],
  "dns": {
    "servers": [
      "https+local://dns.example.invalid/dns-query",
      "1.1.1.1",
      "localhost"
    ],
    "disableCache": false
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "VLESS-Reality-in"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "custom.example.invalid"
        ],
        "outboundTag": "custom-out"
      }
    ]
  }
}
