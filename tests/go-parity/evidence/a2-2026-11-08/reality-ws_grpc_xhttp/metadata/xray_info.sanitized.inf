 —————————————— Clash 配置分享 —————————————— 
 Clash 配置分享: 
proxies:

  - name: VLESS-<redacted-ip>-tcp
    type: vless
    server: <redacted-ip>
    port: 443
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: true
    flow: xtls-rprx-vision
    network: tcp
    skip-cert-verify: false
    servername: www.cloudflare.com
    reality-opts:
      public-key: <redacted-key>
      short-id: <redacted-shortid>
      spider-x: /assets/2avkm5x6.css

  - name: VLESS-<redacted-ip>-ws
    type: vless
    server: <redacted-ip>
    port: 10972
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: false
    network: ws
    ws-opts:
      path: /6fc0048a9ebe4f
      headers:
        Host: <redacted-ip>
    skip-cert-verify: false

  - name: VLESS-<redacted-ip>-grpc
    type: vless
    server: <redacted-ip>
    port: 10837
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: false
    network: grpc
    grpc-opts:
      grpc-service-name: 62eae5fe038e2b
    skip-cert-verify: false

  - name: VLESS-<redacted-ip>-xhttp
    type: vless
    server: <redacted-ip>
    port: 11019
    uuid: <redacted-uuid>
    client-fingerprint: chrome
    tls: false
    network: xhttp
    xhttp-opts:
      path: /b5d2c8bbde3de9
      mode: auto
    skip-cert-verify: false

