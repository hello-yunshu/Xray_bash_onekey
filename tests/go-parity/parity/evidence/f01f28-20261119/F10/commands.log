            backup create [--out FILE] [--include-geodata]
                                 打包托管状态（含私钥，0600，拒绝覆盖）
            backup verify --archive FILE
                                 只读校验归档哈希与路径，不解包
            backup restore --archive FILE [--no-pre-backup]
