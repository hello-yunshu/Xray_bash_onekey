    "official": "R1",
    "r1": {
      "argv": ["idleleo", "xray", "install", "--keep-config", "--binary", "/opt/xray/xray", "--container"],
      "scenarios": ["M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9", "M10"],
      "assertions": ["U1", "U2", "U3", "U4", "U5", "U6", "U7"]
    },
    "r2": {
      "argv": ["idleleo", "bridge", "prepare", "--candidate", "/opt/go/idleleo", "--recovery", "/tmp/e2e-recovery", "--container"],
      "then": ["idleleo bridge validate --json", "idleleo bridge activate --container"],
      "spotScenarios": ["M1", "M4"],
      "assertions": ["U1", "U2", "U3", "U4", "U5"]
    },
    "assertions": {
      "U1": "config semantic equality; no silent rewrite without --rewrite-config",
      "U2": "cert/key bytes and mtime unchanged",
      "U3": "systemd unit valid, service active, listening ports unchanged",
      "U4": "xray -test and nginx -t pass",
      "U5": "client config unchanged still connects",
      "U6": "status --json reports same mode/transport/role",
      "U7": "cron/schedule migrated without duplicates or loss",
      "U8": "uninstall + snapshot restore returns to bash state and connectivity"
    },
    "injections": [
      {"id": "I1", "name": "corrupt-config", "method": "write invalid JSON to runtime config", "expect": "rc!=0, error names the config file, pre-state manifest unchanged"},
      {"id": "I2", "name": "missing-cert", "method": "move cert/key away", "expect": "rc!=0, error names missing cert path, pre-state manifest unchanged"},
      {"id": "I3", "name": "port-in-use", "method": "hold 443 before install", "expect": "rc!=0, error names the port, pre-state manifest unchanged"},
      {"id": "I4", "name": "read-only-target", "method": "bind mount + remount ro; fallback chattr +i", "expect": "rc!=0, error names the path, pre-state manifest unchanged"}
    ]
