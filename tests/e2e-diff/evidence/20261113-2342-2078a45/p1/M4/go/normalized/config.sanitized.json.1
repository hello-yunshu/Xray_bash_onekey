{
  "dns": {
    "disableCache": false,
    "servers": [
      "https+local://dns.google/dns-query",
      "https+local://cloudflare-dns.com/dns-query",
      "https+local://doh.opendns.com/dns-query",
      "208.67.222.222",
      "8.8.8.8",
      "1.1.1.1",
      "localhost"
    ]
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 9000,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "email": "me@hey.run",
            "id": "REDACTED",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "realitySettings": {
          "privateKey": "REDACTED"
        },
        "security": "none",
        "wsSettings": {
          "path": "/ray/"
        }
      },
      "tag": "VLESS-ws-in"
    }
  ],
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "VLESS-ws-in"
        ],
        "outboundTag": "direct",
        "type": "field"
      }
    ]
  }
}
