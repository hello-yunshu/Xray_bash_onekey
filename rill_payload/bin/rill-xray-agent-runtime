#!/usr/bin/env python3
import argparse
from pathlib import Path
import sys
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'python'))
from rill_xray_agent.runtime_service import RuntimeService
p=argparse.ArgumentParser();p.add_argument('--socket',type=Path,default=Path('/run/rill-xray-agent/runtime.sock'));p.add_argument('--state-root',type=Path,default=Path('/var/lib/rill-xray-agent-runtime'));p.add_argument('--transaction-root',type=Path,default=Path('/var/lib/rill-xray-agent-root/transactions'));a=p.parse_args();RuntimeService(a.state_root,a.transaction_root).serve(a.socket)
