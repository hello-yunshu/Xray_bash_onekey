[Unit]
Description=Rill Xray Agent Xray observation
After=xray.service nginx.service
[Service]
Type=oneshot
User=root
Group=rill-xray-agent
UMask=0027
Environment=RILL_XRAY_HOST_ROOT=/etc/idleleo
ExecStart=/usr/bin/python3 /etc/rill-xray-agent/scripts/rill_xray_agent_observe.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rill-xray-agent-xray
