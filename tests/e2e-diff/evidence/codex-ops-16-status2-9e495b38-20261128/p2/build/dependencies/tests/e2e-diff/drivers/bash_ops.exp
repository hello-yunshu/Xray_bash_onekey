#!/usr/bin/expect -f
# Drives the REAL install.sh management menu for the OPS rows that the
# differential matrix previously listed without an execution path.
#
# One process per OPS id (E2E_OPS_ID). Every answer is sent only after its own
# prompt has been matched; an unmatched prompt, EOF or timeout exits 124 and is
# reported as HARNESS-ERROR. A missing prerequisite (no managed Nginx) is exit 3
# with a machine-readable reason, never a silent
# pass. OPS-10 drives the nested file_manager menu; a nested.json BLOCKED is
# only written when the menu cannot be reached at all.
#
# Environment:
#   E2E_OPS_ID        OPS-04 | OPS-05 | OPS-06 | OPS-07 | OPS-10 | OPS-17c | OPS-23 | OPS-30
#   E2E_LOG           transcript path (append)
#   E2E_TIMEOUT       expect timeout seconds (default 900)
#   E2E_TARGET        Reality target domain (default www.cloudflare.com)
#   E2E_PORT_ALT      replacement inbound port (default 8443)
#   E2E_UUID_LABEL    custom UUIDv5 mapping string (default e2e-uuid)
#
# Exit codes: 0 success, 1 business failure, 3 documented prerequisite missing,
#             124 harness error.

set timeout [expr {[info exists env(E2E_TIMEOUT)] ? $env(E2E_TIMEOUT) : 900}]

set logf $env(E2E_LOG)
log_file -a $logf

set opsid $env(E2E_OPS_ID)
set target [expr {[info exists env(E2E_TARGET)] ? $env(E2E_TARGET) : "www.cloudflare.com"}]
set port_alt [expr {[info exists env(E2E_PORT_ALT)] ? $env(E2E_PORT_ALT) : "8443"}]
set uuid_label [expr {[info exists env(E2E_UUID_LABEL)] ? $env(E2E_UUID_LABEL) : "e2e-uuid"}]
set ops10_domain [expr {[info exists env(E2E_OPS10_DOMAIN)] ? $env(E2E_OPS10_DOMAIN) : "ops10.example.com"}]

proc harness_error {msg} {
    puts "HARNESS-ERROR: $msg"
    exit 124
}

proc blocked {reason {kind "blocked"}} {
    global logf
    set dir [file dirname $logf]
    set fh [open "$dir/$kind.json" w]
    puts $fh "{\"status\":\"BLOCKED\",\"reason\":\"$reason\"}"
    close $fh
    puts "BLOCKED: $reason"
    exit 3
}

proc step {header prompt answer label} {
    expect {
        -re $header { }
        eof { harness_error "$label: eof before header '$header'" }
        timeout { harness_error "$label: timeout waiting header '$header'" }
    }
    expect {
        -re $prompt {
            send "$answer\r"
            puts "STEP\[$label\]=$answer"
        }
        eof { harness_error "$label: eof before prompt '$prompt'" }
        timeout { harness_error "$label: timeout waiting prompt '$prompt'" }
    }
}

proc ask {prompt answer label} {
    expect {
        -re $prompt {
            send "$answer\r"
            puts "STEP\[$label\]=$answer"
        }
        eof { harness_error "$label: eof before prompt '$prompt'" }
        timeout { harness_error "$label: timeout waiting prompt '$prompt'" }
    }
}

proc navigate {path} {
    foreach item [split $path ">"] {
        expect {
            -re {请输入选项} {
                send "$item\r"
                puts "STEP\[menu\]=$item"
            }
            eof { harness_error "menu: eof before prompt (item $item)" }
            timeout { harness_error "menu: timeout before prompt (item $item)" }
        }
    }
}

# Leave install.sh cleanly. A menu action returns to its parent menu, so "0" at
# the configuration submenu only moves one level up. Keep answering 0 until the
# process exits; a pause prompt may appear on some paths.
proc close_menu {} {
    for {set depth 0} {$depth < 6} {incr depth} {
        expect {
            # OPS-30 switches the menu language, so the trailing prompts can be
            # English after the action returns.
            -re {回到菜单|按回车|Back to the menu|Press Enter} {
                send "\r"
                puts "STEP\[pause\]=enter"
                exp_continue
            }
            -re {请输入选项|please enter an option} {
                send "0\r"
                puts "STEP\[exit\]=0"
            }
            -re {安装失败|自动恢复失败} { puts "INSTALL_FAILED"; exit 1 }
            eof {
                set rc [wait]
                puts "EXPECT_WAIT_STATUS=$rc"
                exit [lindex $rc 3]
            }
            timeout { harness_error "menu did not exit (level $depth)" }
        }
    }
    harness_error "menu nesting exceeded 6 levels"
}

proc finish {} {
    close_menu
}

proc ops04 {} {
    global port_alt
    navigate "2>2>2"
    step {确定端口} {请输入端口} $port_alt port
    finish
}

proc ops05 {} {
    global uuid_label
    navigate "2>2>1"
    ask {是否需要自定义字符串映射} y uuid5
    ask {请输入自定义字符串} $uuid_label uuid5Label
    finish
}

proc ops06 {} {
    global target
    navigate "2>2>3"
    # target_set runs an nmap/curl TLS check; offline this lands on the
    # documented "set anyway" branch, which is the same branch the runner
    # pins for every other target_set call.
    expect {
        -re {确认域名符合要求后请输入} {
            send "$target\r"
            puts "STEP\[target\]=$target"
            exp_continue
        }
        -re {是否仍要设置此域名} {
            send "y\r"
            puts "STEP\[targetForce\]=y"
            exp_continue
        }
        -re {是否需要自定义 .*serverNames} {
            send "n\r"
            puts "STEP\[serverNames\]=n"
        }
        eof { harness_error "ops06: eof during target_set" }
        timeout { harness_error "ops06: timeout during target_set" }
    }
    finish
}

proc ops07 {} {
    if {![file exists "/usr/local/nginx/conf/nginx.conf"]} {
        blocked "managed-nginx-absent"
    }
    navigate "2>2>4"
    step {请选择 TLS 版本} {请输入[:：]} 2 tlsVersion
    finish
}

proc ops10 {} {
    if {![file exists "/usr/local/nginx/conf/nginx.conf"]} {
        blocked "managed-nginx-absent"
    }
    global ops10_domain
    navigate "2>3>2"
    ask {是否变更} y nginxServerNames
    # The nested file_manager menu creates one "<domain>.serverNames" fragment
    # under a domain that is not the install target, so the before/after
    # snapshot proves the write instead of re-observing the install default.
    ask {请选择一个选项} 2 fmCreate
    expect {
        -re {请输入网址} { }
        eof { harness_error "ops10: eof before the serverNames URL prompt" }
        timeout { harness_error "ops10: timeout before the serverNames URL prompt" }
    }
    ask {请输入[:：]} $ops10_domain fmDomain
    expect {
        -re {已创建} { puts "STEP\[fmCreated\]=yes" }
        eof { harness_error "ops10: eof before the creation confirmation" }
        timeout { harness_error "ops10: timeout before the creation confirmation" }
    }
    ask {请选择一个选项} 5 fmExit
    close_menu
}

proc ops17c {} {
    navigate "5>4"
    # Answer exactly one prompt, then let close_menu drain the trailing
    # "回到菜单 [Enter]" pause; exp_continue here would spin on that pause.
    expect {
        -re {是否启用} {
            send "y\r"
            puts "STEP\[autoUpdate\]=y"
        }
        -re {是否关闭} {
            send "n\r"
            puts "STEP\[autoUpdateClose\]=n"
        }
        -re {已设置自动更新} {
            puts "STEP\[autoUpdateAlreadySet\]=yes"
        }
        -re {请输入选项} { send "0\r"; puts "STEP\[exit\]=0" }
        eof { }
        timeout { harness_error "ops17c: timeout waiting for the auto-update prompt" }
    }
    close_menu
}

proc ops17a {} {
    # Exercise the real script-update menu with a PTY. On the pinned current
    # Bash release the updater reports "already latest" and returns to the
    # menu; draining that menu is part of the operation, otherwise a piped-EOF
    # harness loops until timeout and misreports the product result.
    ask {请输入选项} 5 updateMenu
    ask {请输入选项} 1 updateScript
    expect {
        -re {当前已经是最新版本} { puts "STEP\[scriptUpdate\]=already-latest" }
        -re {更新.*完成} { puts "STEP\[scriptUpdate\]=updated" }
        -re {更新失败|拒绝更新|校验失败} { harness_error "ops17a: update rejected" }
        eof { harness_error "ops17a: eof before update result" }
        timeout { harness_error "ops17a: timeout waiting for update result" }
    }
    finish
}

proc ops30 {} {
    navigate "8"
    ask {请输入数字} 2 language
    finish
}

# --- state/query OPS added in round 3 (D07 remainder) ----------------------

proc ops08 {} {
    navigate "2>2>5"
    expect {
        -re {异常 SNI 处理方式|请选择 SNI|SNI Guard} { }
        eof { harness_error "ops08: eof before the SNI policy header" }
        timeout { harness_error "ops08: timeout before the SNI policy header" }
    }
    # 1 = isolate (the documented default and the Go baseline).
    ask {请输入选项} 1 sniPolicy
    finish
}

proc ops11 {} {
    navigate "3>1"
    expect {
        -re {协议|port|域名|UUID|地址|mode} { puts "STEP\[infoOutput\]=present" }
        eof { harness_error "ops11: eof before configuration output" }
        timeout { harness_error "ops11: timeout before configuration output" }
    }
    finish
}

proc ops15 {} {
    # Restart every service; the runner then reads systemctl is-active.
    navigate "4>1>1"
    finish
}

proc ops16 {} {
    # Read status, validity and scheduler state from the real TLS menu. The
    # seeded fixture is user-managed, so this probe never renews or edits it.
    navigate "4>2"
    ask {请输入选项} 1 certStatus
    expect {
        -re {证书状态|证书存在|证书有效|证书无效|证书剩余天数} { puts "STEP\[certStatus\]=observed" }
        eof { harness_error "ops16: eof before certificate status" }
        timeout { harness_error "ops16: timeout waiting for certificate status" }
    }
    expect {
        -re {回到菜单|按回车} { send "\r"; puts "STEP\[pause\]=enter" }
        eof { harness_error "ops16: eof after certificate status" }
        timeout { harness_error "ops16: timeout after certificate status" }
    }
    ask {请输入选项} 2 certValidity
    expect {
        -re {证书剩余天数|证书生成日期|证书有效期|检测到用户自备证书, 已跳过自动续签} { puts "STEP\[certValidity\]=observed" }
        eof { harness_error "ops16: eof before certificate validity" }
        timeout { harness_error "ops16: timeout waiting for certificate validity" }
    }
    expect {
        -re {回到菜单|按回车} { send "\r"; puts "STEP\[pause\]=enter" }
        eof { harness_error "ops16: eof after certificate validity" }
        timeout { harness_error "ops16: timeout after certificate validity" }
    }
    ask {请输入选项} 3 certScheduler
    expect {
        -re {未检测到任何证书续期调度|acme\.sh 续期调度已存在|已保留原有调度|是否需要删除改版证书自动更新} {
            if {[string match "*是否需要删除改版证书自动更新*" $expect_out(0,string)]} {
                send "n\r"
                puts "STEP\[preserveScheduler\]=n"
            }
            puts "STEP\[certScheduler\]=observed"
        }
        eof { harness_error "ops16: eof before scheduler status" }
        timeout { harness_error "ops16: timeout waiting for scheduler status" }
    }
    finish
}

proc ops14 {} {
    # Observe the exact Bash 3>4 port monitor in a PTY. The runner starts a
    # real client request after this marker is written while iftop is live.
    navigate "3>4"
    expect {
        -re {按 q 键退出 iftop} { puts "STEP\[iftopPrompt\]=observed" }
        -re {iftop 安装失败|流量监控功能不可用} { harness_error "ops14: iftop unavailable" }
        eof { harness_error "ops14: eof before iftop" }
        timeout { harness_error "ops14: timeout waiting for iftop" }
    }
    expect {
        -re {TX:} { puts "STEP\[iftopCounters\]=visible" }
        eof { harness_error "ops14: iftop exited before drawing counters" }
        timeout { harness_error "ops14: iftop did not draw counters" }
    }
    after 9000
    send "q"
    puts "STEP\[iftopQuit\]=q"
    expect {
        -re {回到菜单|按回车} { send "\r"; puts "STEP\[iftopReturned\]=yes" }
        eof { harness_error "ops14: iftop exited unexpectedly" }
        timeout { harness_error "ops14: iftop did not return" }
    }
    finish
}

proc ops20 {} {
    navigate "6>3"
    # 1 enables statistics (it asks for confirmation), 2 prints them.
    ask {请输入选项} 1 statsEnable
    expect {
        -re {是否继续} {
            send "y\r"
            puts "STEP\[statsEnableConfirm\]=y"
            exp_continue
        }
        -re {回到菜单|按回车} {
            send "\r"
            puts "STEP\[pause\]=enter"
            exp_continue
        }
        -re {请输入选项} { send "2\r"; puts "STEP\[statsView\]=2" }
        eof { harness_error "ops20: eof before the stats submenu" }
        timeout { harness_error "ops20: timeout before the stats submenu" }
    }
    close_menu
}

proc ops22 {} {
    navigate "6>5"
    # clean_logs asks whether to install weekly logrotate; N keeps the offline
    # run deterministic and does not change what was cleaned.
    expect {
        -re {是否需要设置自动清理日志} {
            send "n\r"
            puts "STEP\[autoCleanLogs\]=n"
        }
        eof { harness_error "ops22: eof before the logrotate prompt" }
        timeout { harness_error "ops22: timeout before the logrotate prompt" }
    }
    finish
}

proc ops23 {} {
    # Drive the real nested menu with Expect's PTY. The speed test runs through
    # the installed idleleo command and reports measured bytes/rate before the
    # menu's final pause. A plain stdin pipe is not a valid probe because the
    # menu action reads /dev/tty.
    # The main-menu action calls clear/read on /dev/tty before rendering the
    # tools submenu. `navigate` sends the next answer as soon as any prompt is
    # observed, which can land in that flush window and be discarded. Match the
    # submenu header before sending its choice so the probe drives the intended
    # action rather than looping back to the main menu.
    step {Xray 管理菜单} {请输入选项} 6 mainMenu
    step {其他选项|Xray 管理选项} {请输入选项} 6 toolsMenu
    expect {
        -re {server: https://speed\.cloudflare\.com} { puts "STEP\[speedtestServer\]=ok" }
        -re {speedtest failed:} { harness_error "ops23: delegated speedtest failed" }
        eof { harness_error "ops23: eof before speedtest output" }
        timeout { harness_error "ops23: timeout waiting for speedtest output" }
    }
    expect {
        -re {bytes: ([1-9][0-9]*)} { puts "STEP\[speedtestBytes\]=$expect_out(1,string)" }
        -re {speedtest failed:} { harness_error "ops23: delegated speedtest failed" }
        eof { harness_error "ops23: eof before measured byte count" }
        timeout { harness_error "ops23: timeout waiting for measured byte count" }
    }
    expect {
        -re {sample\[1\]: ([0-9]+\.[0-9]+) Mbps} { puts "STEP\[speedtestSample\]=$expect_out(1,string)" }
        -re {speedtest failed:} { harness_error "ops23: delegated speedtest failed" }
        eof { harness_error "ops23: eof before measured sample" }
        timeout { harness_error "ops23: timeout waiting for measured sample" }
    }
    finish
}

proc ops28 {} {
    navigate "7>4"
    # confirm uninstall, do not keep the config (matches Go --purge), keep the
    # scripts so the container stays usable for the runner snapshot.
    expect {
        -re {是否继续} { send "y\r"; puts "STEP\[uninstallConfirm\]=y" }
        eof { harness_error "ops28: eof before the uninstall confirmation" }
        timeout { harness_error "ops28: timeout before the uninstall confirmation" }
    }
    expect {
        -re {是否保留配置文件} { send "n\r"; puts "STEP\[keepConfig\]=n" }
        eof { harness_error "ops28: eof before the keep-config prompt" }
        timeout { harness_error "ops28: timeout before the keep-config prompt" }
    }
    expect {
        -re {是否删除所有脚本文件} { send "n\r"; puts "STEP\[keepScripts\]=n" }
        eof { harness_error "ops28: eof before the keep-scripts prompt" }
        timeout { harness_error "ops28: timeout before the keep-scripts prompt" }
    }
    close_menu
}

proc ops27 {} {
    # Backup menu 7>3 = "清空证书文件": an interactive confirm followed by
    # rm -rf of the whole certificate directory. This is deliberately driven
    # so the safety difference against Go's ownership check is real evidence,
    # never a claim of equivalence.
    navigate "7>3"
    ask {是否继续} y certClearConfirm
    finish
}

puts "OPS_ID=$opsid"
set install_src "/src/install.sh"
if {[info exists env(E2E_INSTALL_SRC)] && $env(E2E_INSTALL_SRC) ne ""} {
    set install_src $env(E2E_INSTALL_SRC)
}
spawn bash $install_src

switch -- $opsid {
    OPS-04 { ops04 }
    OPS-05 { ops05 }
    OPS-06 { ops06 }
    OPS-07 { ops07 }
    OPS-10 { ops10 }
    OPS-17a { ops17a }
    OPS-17c { ops17c }
    OPS-30 { ops30 }
    OPS-08 { ops08 }
    OPS-11 { ops11 }
    OPS-15 { ops15 }
    OPS-14 { ops14 }
    OPS-16 { ops16 }
    OPS-20 { ops20 }
    OPS-22 { ops22 }
    OPS-23 { ops23 }
    OPS-27 { ops27 }
    OPS-28 { ops28 }
    default { harness_error "unknown E2E_OPS_ID '$opsid'" }
}
