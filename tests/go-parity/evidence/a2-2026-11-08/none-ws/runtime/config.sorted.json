{
  "dns": {
    "disableCache": false,
    "servers": [
      "https+local://dns.google/dns-query",
      "https+local://cloudflare-dns.com/dns-query",
      "https+local://doh.opendns.com/dns-query",
      "208.67.222.222",
      "8.8.8.8",
      "1.1.1.1",
      "localhost"
    ]
  },
  "geodata": {
    "assets": [
      {
        "file": "geoip.dat",
        "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geoip.dat"
      },
      {
        "file": "geosite.dat",
        "url": "https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download/geosite.dat"
      }
    ],
    "cron": "0 3 * * 1"
  },
  "inbounds": [
    {
      "listen": "127.0.0.1",
      "port": 10805,
      "protocol": "VLESS",
      "settings": {
        "clients": [
          {
            "email": "cdbd40b8@hey.run",
            "id": "<redacted-uuid>",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "realitySettings": {
          "privateKey": "REDACTED",
          "settings": {
            "privateKey": "REDACTED"
          }
        },
        "security": "none",
        "wsSettings": {
          "path": "/d6976c7e"
        }
      },
      "tag": "VLESS-ws-in"
    }
  ],
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "VLESS-ws-in"
        ],
        "outboundTag": "direct",
        "type": "field"
      }
    ]
  }
}
