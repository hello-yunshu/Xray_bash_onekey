[Unit]
Description=Rill Xray Agent Agent
Requires=rill-xray-agent-runtime.service
After=rill-xray-agent-runtime.service
[Service]
Type=simple
User=rill-xray-agent
Group=rill-xray-agent
ExecStart=/opt/rill-xray-agent/bin/rill-xray-agent-agent
Restart=on-failure
# /run/rill-xray-agent is created and owned by the Runtime unit
# (RuntimeDirectory=rill-xray-agent). The Agent must not declare a second
# RuntimeDirectory of the same name: it consumes the Runtime-created
# directory through its Requires/After dependency.
ReadWritePaths=/run/rill-xray-agent
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
UMask=0027
KillMode=control-group
[Install]
WantedBy=multi-user.target
