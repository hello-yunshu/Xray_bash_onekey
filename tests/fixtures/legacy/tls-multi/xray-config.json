{
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "port": 10086,
      "listen": "127.0.0.1",
      "tag": "VLESS-ws-in",
      "protocol": "VLESS",
      "settings": {
        "clients": [
          {
            "id": "11111111-2222-4333-8444-555555555555",
            "level": 0,
            "email": "ws1@example.invalid"
          },
          {
            "id": "66666666-7777-4888-8999-aaaaaaaaaaaa",
            "level": 0,
            "email": "ws2@example.invalid"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/fixture-ws"
        }
      }
    },
    {
      "port": 10087,
      "listen": "127.0.0.1",
      "tag": "VLESS-gRPC-in",
      "protocol": "VLESS",
      "settings": {
        "clients": [
          {
            "id": "11111111-2222-4333-8444-555555555555",
            "level": 0,
            "email": "grpc@example.invalid"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "grpc",
        "security": "none",
        "grpcSettings": {
          "serviceName": "fixture-grpc",
          "multiMode": true,
          "idle_timeout": 20
        }
      }
    },
    {
      "port": 10088,
      "listen": "127.0.0.1",
      "tag": "VLESS-xhttp-in",
      "protocol": "VLESS",
      "settings": {
        "clients": [
          {
            "id": "11111111-2222-4333-8444-555555555555",
            "level": 0,
            "email": "xhttp@example.invalid"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": "/fixture-xhttp",
          "mode": "auto"
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "dns": {
    "servers": [
      "https+local://dns.google/dns-query",
      "https+local://cloudflare-dns.com/dns-query",
      "https+local://doh.opendns.com/dns-query",
      "208.67.222.222",
      "8.8.8.8",
      "1.1.1.1",
      "localhost"
    ],
    "disableCache": false
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "inboundTag": [
          "VLESS-ws-in",
          "VLESS-gRPC-in",
          "VLESS-xhttp-in"
        ],
        "outboundTag": "direct"
      }
    ]
  }
}
