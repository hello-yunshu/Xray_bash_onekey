          "shortIds": [
            "d4615130bbd45453"
          ],
          "settings": {
            "privateKey": "REDACTED"
          }
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
