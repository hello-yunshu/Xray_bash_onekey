{
  "api": {
    "services": [
      "StatsService",
      "HandlerService"
    ],
    "tag": "api"
  },
  "dns": {
    "disableCache": false,
    "servers": [
      "https+local://dns.google/dns-query",
      "https+local://cloudflare-dns.com/dns-query",
      "https+local://doh.opendns.com/dns-query",
      "198.51.100.10",
      "198.51.100.10",
      "198.51.100.10",
      "localhost"
    ]
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "email": "me@hey.run",
            "flow": "xtls-rprx-vision",
            "id": "5e278732-b69c-4475-ad78-1c87eb78c7f0",
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "raw",
        "realitySettings": {
          "minClientVer": "1.0.0",
          "privateKey": "REDACTED",
          "serverNames": [
            "example.com"
          ],
          "shortIds": [
            "813168f8"
          ],
          "target": "www.cloudflare.com:443"
        },
        "security": "reality"
      },
      "tag": "VLESS-Reality-in"
    },
    {
      "listen": "127.0.0.1",
      "port": 10085,
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      },
      "streamSettings": {
        "realitySettings": {
          "privateKey": "REDACTED"
        }
      },
      "tag": "api"
    }
  ],
  "log": {
    "access": "/var/log/xray/access.log",
    "error": "/var/log/xray/error.log",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "domainStrategy": "UseIPv4v6"
        }
      },
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ],
  "policy": {
    "system": {
      "statsInboundDownlink": true,
      "statsInboundUplink": true
    }
  },
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api",
        "type": "field"
      },
      {
        "inboundTag": [
          "VLESS-Reality-in"
        ],
        "outboundTag": "direct",
        "type": "field"
      }
    ]
  },
  "stats": {}
}
