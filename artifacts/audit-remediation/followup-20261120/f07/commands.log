$ /bin/bash -c generate_spiderx() {
    local r
    r=$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c 8)
    [[ -z "${r}" ]] && r="default$(date +%s | tail -c 5)"
    case $((RANDOM % 4)) in
        0) echo "/assets/${r}.css" ;;
        1) echo "/static/${r}.js" ;;
        2) echo "/docs/${r}/index.html" ;;
        *) echo "/api/status/${r}" ;;
    esac
}
